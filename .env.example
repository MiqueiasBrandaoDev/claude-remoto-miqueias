# Painel IA Camozzi - variaveis. Copie para ".env" e preencha.

# Pasta que o painel opera (o workspace do assistente).
WORKSPACE_DIR=D:/documentos/PROJETOS_AIOS/squad-tecnologia

# Auth: token de 1 ano da assinatura (claude setup-token). Vazio = usa credencial local.
CLAUDE_CODE_OAUTH_TOKEN=

# Deploy: o worker (local) aponta pro server na VPS. Mesmo token nos dois lados.
# SERVER_URL=wss://ponte-painel.SEU-DOMINIO
# WORKER_TOKEN=troque-esse-token

# Modelo padrao (haiku|sonnet|opus)
# MODEL=sonnet
